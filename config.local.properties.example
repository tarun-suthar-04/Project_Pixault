# ============================================================
# Pixault - Local Private Configuration Example
# ============================================================
#
# Copy this file to config.local.properties in the project root.
# Never commit config.local.properties to Git.
#
# You can also use environment variables instead:
# PIXAULT_DB_PASSWORD, PIXAULT_MAIL_PASSWORD, PIXAULT_TOKEN_HMAC_SECRET, etc.

# --- Database ---
db.host=localhost
db.port=3306
db.name=pixault_db
db.username=YOUR_MYSQL_USERNAME
db.password=YOUR_MYSQL_PASSWORD
db.useSSL=false
db.allowPublicKeyRetrieval=true

# --- SMTP ---
mail.host=smtp.gmail.com
mail.port=465
mail.username=YOUR_GMAIL_ADDRESS
mail.password=YOUR_GMAIL_APP_PASSWORD
mail.from=Pixault Vault <YOUR_GMAIL_ADDRESS>
mail.auth=true
mail.starttls=false
mail.ssl=true
mail.connectiontimeout.ms=10000
mail.timeout.ms=10000
mail.writetimeout.ms=10000
mail.debug=false

# --- Token Secrets ---
# Generate a long random value before real use.
token.hmac.secret=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# --- App URLs ---
app.base.url=http://localhost:8088
share.public.url=http://localhost:8088
share.bind.host=0.0.0.0
