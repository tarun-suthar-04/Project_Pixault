<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pixault.ui.DashboardController"
            styleClass="auth-root">

    <!-- ===================== TOP HEADER BAR ===================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="dash-header">
            <!-- PIXAULT pill logo -->
            <VBox alignment="CENTER" styleClass="dash-logo-pill">
                <Label text="PIXAULT" styleClass="dash-logo-text"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Session metadata -->
            <HBox alignment="CENTER" spacing="16">
                <Label fx:id="welcomeLabel" text="WELCOME, USER 👋" styleClass="dash-meta-label"/>
                <Label text="|" styleClass="dash-meta-sep"/>
                <Label fx:id="sessionInfoLabel" text="SESSION EXPIRES: --:--" styleClass="dash-meta-label"/>
                <Label text="|" styleClass="dash-meta-sep"/>
                <Label fx:id="deviceLabel" text="DEVICE: --------" styleClass="dash-meta-label"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Theme Toggle -->
            <Button onAction="#onToggleTheme" styleClass="wf-nav-btn">
                <graphic>
                    <SVGPath styleClass="theme-toggle-icon" content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" 
                             scaleX="0.8" scaleY="0.8"/>
                </graphic>
            </Button>

            <!-- Logout button -->
            <Button text="LOGOUT" onAction="#onLogout" styleClass="dash-logout-btn"/>
        </HBox>
    </top>

    <!-- ===================== CENTER CONTENT ===================== -->
    <center>
        <VBox alignment="CENTER" spacing="0" styleClass="content-root">
            <padding>
                <Insets top="40" right="50" bottom="0" left="50"/>
            </padding>

            <!-- HERO SECTION -->
            <VBox alignment="CENTER" spacing="16">
                <!-- Main title pill -->
                <HBox alignment="CENTER">
                    <VBox alignment="CENTER" styleClass="dash-title-pill">
                        <Label text="VAULT DASHBOARD" styleClass="dash-title-text"/>
                    </VBox>
                </HBox>
                <!-- Subtitle pill -->
                <HBox alignment="CENTER">
                    <VBox alignment="CENTER" styleClass="dash-subtitle-pill">
                        <Label text="CHOOSE AN ACTION BELOW" styleClass="dash-subtitle-text"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- SPACER -->
            <Region minHeight="35" maxHeight="35"/>

            <!-- ACTION CARD ROW -->
            <HBox alignment="CENTER" spacing="18" fillHeight="false">

                <!-- 1. HIDE DATA -->
                <VBox alignment="TOP_CENTER" spacing="0" styleClass="dash-card" onMouseClicked="#onHideData"
                      prefWidth="190" minHeight="260">
                    <!-- Icon container -->
                    <VBox alignment="CENTER" styleClass="dash-icon-box">
                        <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"
                               fill="#2563FF" scaleX="1.5" scaleY="1.5"/>
                    </VBox>
                    <VBox spacing="10" alignment="CENTER" style="-fx-padding: 18 16 20 16;">
                        <Label text="HIDE DATA" styleClass="dash-card-title"/>
                        <Region styleClass="dash-card-divider" maxWidth="120" minHeight="2" maxHeight="2"/>
                        <Label text="Encrypt and embed secret text into an image."
                               styleClass="dash-card-desc" wrapText="true" textAlignment="CENTER"/>
                    </VBox>
                </VBox>

                <!-- 2. EXTRACT DATA -->
                <VBox alignment="TOP_CENTER" spacing="0" styleClass="dash-card" onMouseClicked="#onExtractData"
                      prefWidth="190" minHeight="260">
                    <VBox alignment="CENTER" styleClass="dash-icon-box">
                        <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                               fill="#2563FF" scaleX="1.5" scaleY="1.5"/>
                    </VBox>
                    <VBox spacing="10" alignment="CENTER" style="-fx-padding: 18 16 20 16;">
                        <Label text="EXTRACT DATA" styleClass="dash-card-title"/>
                        <Region styleClass="dash-card-divider" maxWidth="120" minHeight="2" maxHeight="2"/>
                        <Label text="Extract and decrypt hidden data from a stego image."
                               styleClass="dash-card-desc" wrapText="true" textAlignment="CENTER"/>
                    </VBox>
                </VBox>

                <!-- 3. SHARE VAULT -->
                <VBox alignment="TOP_CENTER" spacing="0" styleClass="dash-card" onMouseClicked="#onShareVault"
                      prefWidth="190" minHeight="260">
                    <VBox alignment="CENTER" styleClass="dash-icon-box">
                        <SVGPath content="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"
                               fill="#2563FF" scaleX="1.5" scaleY="1.5"/>
                    </VBox>
                    <VBox spacing="10" alignment="CENTER" style="-fx-padding: 18 16 20 16;">
                        <Label text="SHARE VAULT" styleClass="dash-card-title"/>
                        <Region styleClass="dash-card-divider" maxWidth="120" minHeight="2" maxHeight="2"/>
                        <Label text="Generate a one-time secure share link."
                               styleClass="dash-card-desc" wrapText="true" textAlignment="CENTER"/>
                    </VBox>
                </VBox>

                <!-- 4. AUDIT LOG -->
                <VBox alignment="TOP_CENTER" spacing="0" styleClass="dash-card" onMouseClicked="#onAuditLog"
                      prefWidth="190" minHeight="260">
                    <VBox alignment="CENTER" styleClass="dash-icon-box">
                        <SVGPath content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                               fill="#2563FF" scaleX="1.5" scaleY="1.5"/>
                    </VBox>
                    <VBox spacing="10" alignment="CENTER" style="-fx-padding: 18 16 20 16;">
                        <Label text="AUDIT LOG" styleClass="dash-card-title"/>
                        <Region styleClass="dash-card-divider" maxWidth="120" minHeight="2" maxHeight="2"/>
                        <Label text="View security and vault activity events."
                               styleClass="dash-card-desc" wrapText="true" textAlignment="CENTER"/>
                    </VBox>
                </VBox>

                <!-- 5. SETTINGS -->
                <VBox alignment="TOP_CENTER" spacing="0" styleClass="dash-card" onMouseClicked="#onSettings"
                      prefWidth="190" minHeight="260">
                    <VBox alignment="CENTER" styleClass="dash-icon-box">
                        <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                               fill="#2563FF" scaleX="1.5" scaleY="1.5"/>
                    </VBox>
                    <VBox spacing="10" alignment="CENTER" style="-fx-padding: 18 16 20 16;">
                        <Label text="SETTINGS" styleClass="dash-card-title"/>
                        <Region styleClass="dash-card-divider" maxWidth="120" minHeight="2" maxHeight="2"/>
                        <Label text="Change password and review session details."
                               styleClass="dash-card-desc" wrapText="true" textAlignment="CENTER"/>
                    </VBox>
                </VBox>

            </HBox>

            <!-- SPACER -->
            <Region VBox.vgrow="ALWAYS" minHeight="30"/>

            <!-- SECURITY FOOTER -->
            <VBox alignment="CENTER" spacing="14">
                <Separator styleClass="wf-divider" maxWidth="900"/>
                <HBox alignment="CENTER" spacing="24" style="-fx-padding: 0 0 30 0;">
                    <Label text="AES-256-GCM" styleClass="dash-footer-label"/>
                    <Label text="|" styleClass="dash-footer-sep"/>
                    <Label text="ARGON2ID" styleClass="dash-footer-label"/>
                    <Label text="|" styleClass="dash-footer-sep"/>
                    <Label text="HMAC-SHA256" styleClass="dash-footer-label"/>
                    <Label text="|" styleClass="dash-footer-sep"/>
                    <Label text="MFA" styleClass="dash-footer-label"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
