<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.pixault.ui.ForgotPasswordController" styleClass="auth-root">
    <!-- LEFT SIDE -->
    <VBox alignment="CENTER" spacing="25" HBox.hgrow="ALWAYS" minWidth="500" styleClass="auth-branding-area">
        <Label text="PIXAULT" styleClass="auth-logo"/>
        <Region styleClass="auth-divider-blue" maxWidth="150"/>
        <Label text="ACCOUNT RECOVERY" styleClass="auth-subtitle"/>
        
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 40 60;">
            <SVGPath content="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" 
                     fill="#38BDF8" scaleX="3" scaleY="3" style="-fx-opacity: 0.8;"/>
            <Label text="Lost access to your vault?" styleClass="auth-feature-label" style="-fx-font-size: 16px;"/>
            <Label text="No worries. We'll help you reset your credentials using secure OTP verification." 
                   wrapText="true" textAlignment="CENTER" styleClass="auth-footer-text" style="-fx-font-size: 13px; -fx-max-width: 300px;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
        <Label text="© PIXAULT SECURE VAULT" styleClass="auth-footer-text"/>
    </VBox>

    <!-- RIGHT SIDE -->
    <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS" minWidth="450" styleClass="auth-form-area">
        <StackPane>
            <!-- STEP 1: Request Reset -->
            <VBox fx:id="step1Box" spacing="35" styleClass="auth-card" maxWidth="480">
                <VBox spacing="15" alignment="CENTER">
                    <Label text="FORGOT PASSWORD" styleClass="auth-heading"/>
                    <Region styleClass="auth-divider-blue" maxWidth="60"/>
                    <Label text="Enter your email to receive a recovery code" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
                </VBox>
                
                <VBox spacing="20">
                    <VBox spacing="8">
                         <Label text="EMAIL ADDRESS" styleClass="auth-label"/>
                         <HBox styleClass="auth-input-container" style="-fx-pref-height: 50px;" spacing="10">
                             <SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="#6B7280"/>
                             <TextField fx:id="emailField" promptText="Enter your registered email" styleClass="auth-input" HBox.hgrow="ALWAYS"/>
                         </HBox>
                    </VBox>
                    
                    <Label fx:id="statusLabel1" wrapText="true" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 13px;"/>
                    
                    <Button text="SEND RECOVERY CODE" onAction="#onRequestReset" styleClass="auth-btn-primary" maxWidth="Infinity" style="-fx-pref-height: 55px;"/>
                </VBox>
                
                <Hyperlink text="BACK TO LOGIN" onAction="#onBackToLogin" styleClass="auth-link" alignment="CENTER"/>
            </VBox>

            <!-- STEP 2: Verify OTP -->
            <VBox fx:id="step2Box" spacing="35" styleClass="auth-card" maxWidth="480" visible="false">
                <VBox spacing="15" alignment="CENTER">
                    <Label text="VERIFY CODE" styleClass="auth-heading"/>
                    <Region styleClass="auth-divider-blue" maxWidth="60"/>
                    <Label fx:id="otpSentLabel" text="Code sent to your email" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
                </VBox>
                
                <VBox spacing="20">
                    <VBox spacing="8">
                         <Label text="6-DIGIT RECOVERY CODE" styleClass="auth-label"/>
                         <HBox styleClass="auth-input-container" style="-fx-pref-height: 60px;" spacing="10" alignment="CENTER">
                             <TextField fx:id="otpField" promptText="000000" styleClass="auth-input" 
                                       style="-fx-font-size: 24px; -fx-alignment: center; -fx-letter-spacing: 8px;" HBox.hgrow="ALWAYS"/>
                         </HBox>
                    </VBox>
                    
                    <Label fx:id="statusLabel2" wrapText="true" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 13px;"/>
                    
                    <Button text="VERIFY CODE" onAction="#onVerifyOtp" styleClass="auth-btn-primary" maxWidth="Infinity" style="-fx-pref-height: 55px;"/>
                </VBox>
                
                <Hyperlink text="RESEND CODE" onAction="#onRequestReset" styleClass="auth-link" alignment="CENTER"/>
            </VBox>

            <!-- STEP 3: Reset Password -->
            <VBox fx:id="step3Box" spacing="35" styleClass="auth-card" maxWidth="480" visible="false">
                <VBox spacing="15" alignment="CENTER">
                    <Label text="NEW PASSWORD" styleClass="auth-heading"/>
                    <Region styleClass="auth-divider-blue" maxWidth="60"/>
                </VBox>
                
                <VBox spacing="20">
                    <VBox spacing="8">
                         <Label text="NEW PASSWORD" styleClass="auth-label"/>
                         <HBox styleClass="auth-input-container" style="-fx-pref-height: 50px;" spacing="10">
                             <PasswordField fx:id="newPasswordField" promptText="Minimum 12 characters" styleClass="auth-input" HBox.hgrow="ALWAYS"/>
                         </HBox>
                    </VBox>
                    
                    <VBox spacing="8">
                         <Label text="CONFIRM PASSWORD" styleClass="auth-label"/>
                         <HBox styleClass="auth-input-container" style="-fx-pref-height: 50px;" spacing="10">
                             <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" styleClass="auth-input" HBox.hgrow="ALWAYS"/>
                         </HBox>
                    </VBox>
                    
                    <Label fx:id="statusLabel3" wrapText="true" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 13px;"/>
                    
                    <Button text="UPDATE PASSWORD" onAction="#onResetPassword" styleClass="auth-btn-primary" maxWidth="Infinity" style="-fx-pref-height: 55px;"/>
                </VBox>
            </VBox>
        </StackPane>
    </VBox>
</HBox>
