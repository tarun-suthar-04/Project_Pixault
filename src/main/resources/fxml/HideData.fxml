<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pixault.ui.HideDataController"
            styleClass="auth-root">

    <!-- ===================== TOP HEADER BAR ===================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="wf-header">
            <!-- BACK pill button -->
            <Button text="&lt;- BACK" onAction="#onDashboard" styleClass="wf-nav-btn"/>
            <!-- HIDE DATA active pill button -->
            <HBox styleClass="wf-nav-active-pill" alignment="CENTER" spacing="8">
                <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"
                       fill="#2563FF" scaleX="0.85" scaleY="0.85"/>
                <Label text="HIDE DATA" styleClass="wf-nav-active-text"/>
            </HBox>
        </HBox>
    </top>

    <!-- ===================== CONTENT ===================== -->
    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="wf-scroll-pane">
                <VBox alignment="TOP_CENTER" spacing="0" styleClass="content-root">
                    <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

                    <!-- HERO SECTION -->
                    <VBox alignment="CENTER" spacing="12">
                        <HBox alignment="CENTER">
                            <VBox alignment="CENTER" styleClass="wf-title-pill">
                                <Label text="ENCRYPT AND HIDE" styleClass="wf-title-text"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER">
                            <VBox alignment="CENTER" styleClass="wf-subtitle-pill">
                                <Label text="Select a cover image, enter a secret, and save a PNG stego image."
                                       styleClass="wf-subtitle-text"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Region minHeight="25" maxHeight="25"/>

                    <!-- 2-COLUMN WORKFLOW GRID -->
                    <HBox spacing="20" alignment="TOP_CENTER">

                        <!-- LEFT COLUMN -->
                        <VBox spacing="16" HBox.hgrow="ALWAYS">

                            <!-- STEP 1: SELECT COVER IMAGE -->
                            <HBox styleClass="wf-card" spacing="18" alignment="TOP_LEFT">
                                <!-- Icon box -->
                                <VBox alignment="CENTER" styleClass="wf-icon-box" minWidth="72" minHeight="72">
                                    <SVGPath content="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                           fill="#2563FF" scaleX="1.6" scaleY="1.6"/>
                                </VBox>
                                <!-- Step content -->
                                <VBox spacing="12" HBox.hgrow="ALWAYS">
                                    <!-- Step badge + title row -->
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <VBox alignment="CENTER" styleClass="wf-step-badge" minWidth="28" minHeight="28">
                                            <Label text="1" styleClass="wf-step-badge-text"/>
                                        </VBox>
                                        <Label text="SELECT COVER IMAGE" styleClass="wf-section-title"/>
                                    </HBox>
                                    <Region styleClass="wf-blue-divider" maxWidth="Infinity" minHeight="2" maxHeight="2"/>
                                    <!-- Browse row -->
                                    <HBox alignment="CENTER_LEFT" spacing="16">
                                        <Button text="BROWSE IMAGE" onAction="#onSelectImage" styleClass="wf-browse-btn"/>
                                        <Label fx:id="selectedImageLabel" text="No image selected" styleClass="wf-helper-text"/>
                                    </HBox>
                                    <Label text="Supported formats: PNG, JPG, JPEG, BMP, WEBP" styleClass="wf-helper-text"/>
                                </VBox>
                            </HBox>

                            <!-- STEP 2: SECRET PAYLOAD -->
                            <HBox styleClass="wf-card" spacing="18" alignment="TOP_LEFT">
                                <!-- Icon box -->
                                <VBox alignment="CENTER" styleClass="wf-icon-box" minWidth="72" minHeight="72">
                                    <SVGPath content="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"
                                           fill="#2563FF" scaleX="1.6" scaleY="1.6"/>
                                </VBox>
                                <!-- Step content -->
                                <VBox spacing="12" HBox.hgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <VBox alignment="CENTER" styleClass="wf-step-badge" minWidth="28" minHeight="28">
                                            <Label text="2" styleClass="wf-step-badge-text"/>
                                        </VBox>
                                        <Label text="SECRET PAYLOAD" styleClass="wf-section-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="charCountLabel" text="0 characters" styleClass="wf-helper-text"/>
                                    </HBox>
                                    <Region styleClass="wf-blue-divider" maxWidth="Infinity" minHeight="2" maxHeight="2"/>
                                    <TextArea fx:id="payloadArea" prefRowCount="5"
                                              promptText="Enter your secret message"
                                              styleClass="wf-textarea"/>
                                    <Label text="Enter the secret message you want to hide inside the image."
                                           styleClass="wf-helper-text" wrapText="true"/>
                                </VBox>
                            </HBox>

                        </VBox>

                        <!-- RIGHT COLUMN -->
                        <VBox spacing="16" HBox.hgrow="ALWAYS">

                            <!-- STEP 3: ENCRYPTION PASSWORD -->
                            <HBox styleClass="wf-card" spacing="18" alignment="TOP_LEFT">
                                <!-- Icon box -->
                                <VBox alignment="CENTER" styleClass="wf-icon-box" minWidth="72" minHeight="72">
                                    <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.38-2.32 6.54-5 7.57-2.68-1.03-5-4.19-5-7.57V7.18L12 5zm-2 7.41L8.59 11 7 12.41l3 3L16 9.41 14.59 8 10 12.41z"
                                           fill="#2563FF" scaleX="1.6" scaleY="1.6"/>
                                </VBox>
                                <!-- Step content -->
                                <VBox spacing="12" HBox.hgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <VBox alignment="CENTER" styleClass="wf-step-badge" minWidth="28" minHeight="28">
                                            <Label text="3" styleClass="wf-step-badge-text"/>
                                        </VBox>
                                        <Label text="ENCRYPTION PASSWORD" styleClass="wf-section-title"/>
                                    </HBox>
                                    <Region styleClass="wf-blue-divider" maxWidth="Infinity" minHeight="2" maxHeight="2"/>
                                    <HBox styleClass="auth-input-container" style="-fx-pref-height: 50px;" spacing="10" alignment="CENTER_LEFT">
                                        <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6z"
                                               fill="#6B7280" scaleX="0.9" scaleY="0.9"/>
                                        <PasswordField fx:id="passwordField" promptText="Password for hiding and extraction"
                                                      styleClass="auth-input" HBox.hgrow="ALWAYS"/>
                                        <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                               fill="#6B7280" scaleX="0.9" scaleY="0.9"/>
                                    </HBox>
                                    <Label text="This password is required to extract the hidden data."
                                           styleClass="wf-helper-text" wrapText="true"/>
                                </VBox>
                            </HBox>

                            <!-- ENCRYPT ACTION CARD -->
                            <VBox styleClass="wf-card" alignment="CENTER" spacing="16">
                                <Label fx:id="statusLabel" wrapText="true" maxWidth="Infinity"
                                       alignment="CENTER" textAlignment="CENTER"
                                       style="-fx-font-family: 'Google Sans Medium'; -fx-font-size: 13px; -fx-text-fill: #E53E3E;"/>
                                <Button fx:id="hideBtn" text="ENCRYPT AND HIDE DATA"
                                        onAction="#onHide"
                                        styleClass="wf-primary-btn"
                                        maxWidth="Infinity"
                                        style="-fx-pref-height: 58px;"/>
                            </VBox>

                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>

            <!-- SKELETON OVERLAY -->
            <VBox fx:id="loadingOverlay" visible="false" styleClass="loading-overlay" spacing="20">
                <Label text="PROCESSING SECURE VAULT..." styleClass="wf-section-title" style="-fx-text-fill: #2563FF;"/>
                <VBox spacing="10" alignment="CENTER" maxWidth="400">
                    <Region prefHeight="40" prefWidth="300" styleClass="skeleton"/>
                    <Region prefHeight="20" prefWidth="250" styleClass="skeleton"/>
                    <Region prefHeight="20" prefWidth="280" styleClass="skeleton"/>
                </VBox>
                <ProgressIndicator prefWidth="50" prefHeight="50"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
