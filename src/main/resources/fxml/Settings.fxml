<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pixault.ui.SettingsController"
            styleClass="auth-root">

    <!-- ===================== TOP HEADER BAR ===================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="wf-header">
            <Button text="&lt;- BACK" onAction="#onDashboard" styleClass="wf-nav-btn"/>
            <HBox styleClass="wf-nav-active-pill" alignment="CENTER" spacing="8">
                <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                       fill="#2563FF" scaleX="0.85" scaleY="0.85"/>
                <Label text="SETTINGS" styleClass="wf-nav-active-text"/>
            </HBox>
        </HBox>
    </top>

    <!-- ===================== CONTENT ===================== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="wf-scroll-pane">
            <VBox alignment="TOP_CENTER" spacing="0"
                  styleClass="content-root">
                <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

                <!-- HERO SECTION — centered, matches all other pages -->
                <VBox alignment="CENTER" spacing="12">
                    <HBox alignment="CENTER">
                        <VBox alignment="CENTER" styleClass="wf-title-pill">
                            <Label text="SECURITY SETTINGS" styleClass="wf-title-text"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER">
                        <VBox alignment="CENTER" styleClass="wf-subtitle-pill">
                            <Label text="Manage vault security, change credentials, and review sessions."
                                   styleClass="wf-subtitle-text"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Region minHeight="25" maxHeight="25"/>

                <!-- ===== SINGLE-COLUMN STACKED CARDS ===== -->
                <VBox spacing="16">

                    <!-- STEP 1: CURRENT SESSION -->
                    <HBox styleClass="wf-card" spacing="18" alignment="TOP_LEFT">
                        <VBox alignment="CENTER" styleClass="wf-icon-box"
                              minWidth="72" minHeight="72">
                            <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                   fill="#2563FF" scaleX="1.6" scaleY="1.6"/>
                        </VBox>
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" styleClass="wf-step-badge"
                                      minWidth="28" minHeight="28">
                                    <Label text="1" styleClass="wf-step-badge-text"/>
                                </VBox>
                                <Label text="CURRENT SESSION" styleClass="wf-section-title"/>
                            </HBox>
                            <Region styleClass="wf-blue-divider" maxWidth="Infinity"
                                    minHeight="2" maxHeight="2"/>
                            <!-- Session info rows -->
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                       fill="#6B7280" scaleX="0.75" scaleY="0.75"/>
                                <Label fx:id="sessionInfoLabel"
                                       style="-fx-font-family: 'Google Sans Medium'; -fx-font-size: 14px; -fx-text-fill: #374151;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <SVGPath content="M21 3H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H3V5h18v14zm-10-7h9v2h-9zm0-4h9v2h-9zm0 8h9v2h-9zM5 7h2v2H5zm0 4h2v2H5zm0 4h2v2H5z"
                                       fill="#6B7280" scaleX="0.75" scaleY="0.75"/>
                                <Label fx:id="deviceLabel"
                                       style="-fx-font-family: 'Google Sans Medium'; -fx-font-size: 14px; -fx-text-fill: #6B7280;"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- STEP 2: CHANGE PASSWORD -->
                    <HBox styleClass="wf-card" spacing="18" alignment="TOP_LEFT">
                        <VBox alignment="CENTER" styleClass="wf-icon-box"
                              minWidth="72" minHeight="72">
                            <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"
                                   fill="#2563FF" scaleX="1.6" scaleY="1.6"/>
                        </VBox>
                        <VBox spacing="14" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" styleClass="wf-step-badge"
                                      minWidth="28" minHeight="28">
                                    <Label text="2" styleClass="wf-step-badge-text"/>
                                </VBox>
                                <Label text="CHANGE PASSWORD" styleClass="wf-section-title"/>
                            </HBox>
                            <Region styleClass="wf-blue-divider" maxWidth="Infinity"
                                    minHeight="2" maxHeight="2"/>
                            <Label text="Changing your password invalidates all active sessions."
                                   styleClass="wf-helper-text" wrapText="true"/>

                            <!-- CURRENT PASSWORD -->
                            <VBox spacing="5">
                                <Label text="CURRENT PASSWORD"
                                       style="-fx-font-family: 'Google Sans Bold'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6B7280;"/>
                                <HBox styleClass="auth-input-container"
                                      style="-fx-pref-height: 46px;" spacing="10"
                                      alignment="CENTER_LEFT">
                                    <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6z"
                                           fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                                    <PasswordField fx:id="currentPasswordField"
                                                  promptText="Enter current password"
                                                  styleClass="auth-input" HBox.hgrow="ALWAYS"/>
                                    <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                           fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                                </HBox>
                            </VBox>

                            <!-- NEW PASSWORD -->
                            <VBox spacing="5">
                                <Label text="NEW PASSWORD"
                                       style="-fx-font-family: 'Google Sans Bold'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6B7280;"/>
                                <HBox styleClass="auth-input-container"
                                      style="-fx-pref-height: 46px;" spacing="10"
                                      alignment="CENTER_LEFT">
                                    <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6z"
                                           fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                                    <PasswordField fx:id="newPasswordField"
                                                  promptText="At least 12 characters"
                                                  styleClass="auth-input" HBox.hgrow="ALWAYS"/>
                                    <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                           fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                                </HBox>
                            </VBox>

                            <!-- CONFIRM NEW PASSWORD -->
                            <VBox spacing="5">
                                <Label text="CONFIRM NEW PASSWORD"
                                       style="-fx-font-family: 'Google Sans Bold'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6B7280;"/>
                                <HBox styleClass="auth-input-container"
                                      style="-fx-pref-height: 46px;" spacing="10"
                                      alignment="CENTER_LEFT">
                                    <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6z"
                                           fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                                    <PasswordField fx:id="confirmPasswordField"
                                                  promptText="Repeat new password"
                                                  styleClass="auth-input" HBox.hgrow="ALWAYS"/>
                                    <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                           fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                                </HBox>
                            </VBox>

                            <!-- Status + Action button -->
                            <Label fx:id="pwStatusLabel" wrapText="true" maxWidth="Infinity" styleClass="subheading"/>
                            <Button fx:id="changePasswordBtn" text="CHANGE PASSWORD"
                                    onAction="#onChangePassword"
                                    styleClass="wf-primary-btn"
                                    maxWidth="300"
                                    style="-fx-pref-height: 52px;"/>
                        </VBox>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
